# Composer — third-party code (never push; CI and clones use `composer install`)
/vendor/

# Composer machine-specific credentials (never push)
/auth.json

# PHPUnit cache (local machine)
/.phpunit.result.cache
/.phpunit.cache/

# Secrets / environment
.env
.env.*
!.env.example

# IDE / OS
.idea/
.vscode/
*.sublime-*
.DS_Store
Thumbs.db

# Logs
*.log

# Coverage / artefacts (optional local output)
coverage/
*.clover
build/

# PDF vendor bundle (build artefact; uploaded to GitHub Releases)
/vendor-pdf.zip
/vendor-pdf.zip.sha256

# SHA-256 of vendor-pdf.zip, bundled into the release zip by the Release
# workflow to enable checksum verification by default (see class-wpmar-pdf-installer.php)
/vendor-pdf.sha256

# Fonts extracted from vendor-pdf.zip — downloaded at runtime via the admin installer
/fonts/
